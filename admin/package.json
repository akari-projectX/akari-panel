{
  "name": "akari-admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc --noEmit && rm -rf dist && ADMIN_ENTRY=login vite build && ADMIN_ENTRY=console vite build && node scripts/check-bundles.mjs && node scripts/bundle-report.mjs",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "tsc --noEmit && npm run lint && node scripts/check-error-codes.mjs && node scripts/check-tokens.mjs && vitest run",
    "e2e": "playwright test"
  },
