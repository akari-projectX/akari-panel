{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.html",
    "src/main.tsx",
    "src/boot/boot.js",
    "scripts/*.mjs",
    "e2e/*.ts",
    "e2e/*.mjs",
    "e2e/perf/*",
    "playwright.perf.config.ts",
    "src/**/*.test.ts"
  ],
  "ignore": [
    "src/components/ui/**"
  ],
  "ignoreExportsUsedInFile": true
}
