content-type: text/yaml; charset=utf-8
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: ["+.lan","+.local","rule-set:geosite-private","+.msftconnecttest.com","+.msftncsi.com","time.*.com","ntp.*.com"]
  default-nameserver: ["223.5.5.5"]
  proxy-server-nameserver: ["https://223.5.5.5/dns-query","https://doh.pub/dns-query"]
  nameserver-policy:
    "rule-set:geosite-private,geosite-cn": ["https://223.5.5.5/dns-query","https://doh.pub/dns-query"]
  nameserver: ["https://1.1.1.1/dns-query","https://8.8.8.8/dns-query"]
  respect-rules: true
proxies:
proxy-groups:
  - name: "🚀 默认代理"
    type: select
    proxies:
      - "♻️ 全部节点"
  - name: "🎬 Netflix"
    type: select
    proxies:
      - "🚀 默认代理"
      - "♻️ 全部节点"
      - DIRECT
  - name: "🔍 Google"
    type: select
    proxies:
      - "🚀 默认代理"
      - "♻️ 全部节点"
      - DIRECT
  - name: "📺 YouTube"
    type: select
    proxies:
      - "🚀 默认代理"
      - "♻️ 全部节点"
      - DIRECT
  - name: "✈️ Telegram"
    type: select
    proxies:
      - "🚀 默认代理"
      - "♻️ 全部节点"
      - DIRECT
  - name: "🤖 AI 服务"
    type: select
    proxies:
      - "🚀 默认代理"
      - "♻️ 全部节点"
      - DIRECT
  - name: "♻️ 全部节点"
    type: select
    proxies:
      - DIRECT
rule-providers:
  geosite-category-ads-all:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/category-ads-all.list"
    interval: 86400
  geosite-private:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/private.list"
    interval: 86400
  geoip-private:
    type: http
    behavior: ipcidr
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/private.list"
    interval: 86400
  geosite-cn:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.list"
    interval: 86400
  geoip-cn:
    type: http
    behavior: ipcidr
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/cn.list"
    interval: 86400
  geosite-netflix:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/netflix.list"
    interval: 86400
  geosite-google:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/google.list"
    interval: 86400
  geosite-youtube:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/youtube.list"
    interval: 86400
  geosite-telegram:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/telegram.list"
    interval: 86400
  geoip-telegram:
    type: http
    behavior: ipcidr
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/telegram.list"
    interval: 86400
  geosite-category-ai-!cn:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/category-ai-!cn.list"
    interval: 86400
rules:
  - RULE-SET,geosite-category-ads-all,REJECT
  - RULE-SET,geosite-private,DIRECT
  - RULE-SET,geoip-private,DIRECT,no-resolve
  - RULE-SET,geosite-cn,DIRECT
  - RULE-SET,geoip-cn,DIRECT,no-resolve
  - RULE-SET,geosite-netflix,🎬 Netflix
  - RULE-SET,geosite-google,🔍 Google
  - RULE-SET,geosite-youtube,📺 YouTube
  - RULE-SET,geosite-telegram,✈️ Telegram
  - RULE-SET,geoip-telegram,✈️ Telegram,no-resolve
  - RULE-SET,geosite-category-ai-!cn,🤖 AI 服务
  - MATCH,🚀 默认代理





























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































