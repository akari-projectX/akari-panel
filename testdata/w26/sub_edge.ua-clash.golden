content-type: text/yaml; charset=utf-8
proxies:
  - name: "Edge: \"quoted\" - true kcp"
    type: vless
    server: edge.example.com
    port: 65535
    uuid: a1
    network: kcp
  - name: "Edge: \"quoted\" - true split"
    type: vless
    server: edge.example.com
    port: 2
    uuid: a2
    network: xhttp
    xhttp-opts:
      path: "/s p#?"
      host: h.example.com
  - name: "Edge: \"quoted\" - true ws-hdr"
    type: vless
    server: edge.example.com
    port: 3
    uuid: a3
    network: ws
    ws-opts:
      path: /
      headers:
        Host: hdr.example.com
  - name: "Edge: \"quoted\" - true ws-both"
    type: vmess
    server: edge.example.com
    port: 4
    uuid: a4
    alterId: 0
    cipher: auto
    network: ws
    ws-opts:
      path: "/w?ed=2048"
      headers:
        Host: host.example.com
  - name: "Edge: \"quoted\" - true hu"
    type: trojan
    server: edge.example.com
    port: 5
    password: "p@ss word"
    network: ws
    tls: true
    ws-opts:
      path: /
      v2ray-http-upgrade: true
  - name: "Edge: \"quoted\" - true vmg"
    type: vmess
    server: edge.example.com
    port: 7
    uuid: a6
    alterId: 0
    cipher: auto
    network: grpc
    tls: true
    servername: g.example.com
    grpc-opts:
      grpc-service-name: "a b/c"
  - name: "Edge: \"quoted\" - true rx-nofp"
    type: vless
    server: edge.example.com
    port: 8
    uuid: a7
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    client-fingerprint: chrome
    reality-opts:
      public-key: PK
  - name: "Edge: \"quoted\" - true tls-vision"
    type: vless
    server: edge.example.com
    port: 9
    uuid: a8
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    servername: v.example.com
  - name: "Edge: \"quoted\" - true plain-vision"
    type: vless
    server: edge.example.com
    port: 10
    uuid: a9
    network: tcp
  - name: "Edge: \"quoted\" - true ss-tcp"
    type: ss
    server: edge.example.com
    port: 14
    cipher: 2022-blake3-aes-128-gcm
    password: "AAAAAAAAAAAAAAAAAAAAAA==:AQEBAQEBAQEBAQEBAQEBAQ=="
    udp: false
  - name: "Edge: \"quoted\" - true ss-udp-only"
    type: ss
    server: edge.example.com
    port: 15
    cipher: 2022-blake3-aes-256-gcm
    password: "pw:u"
    udp: true
  - name: "Edge: \"quoted\" - true hy-nosni"
    type: hysteria2
    server: edge.example.com
    port: 16
    password: "a:b c"
    alpn:
      - h3
  - name: "Edge: \"quoted\" - true sec-weird"
    type: vless
    server: edge.example.com
    port: 17
    uuid: b4
    network: tcp
  - name: "Edge: \"quoted\" - true tro-123"
    type: trojan
    server: edge.example.com
    port: 18
    password: "123"
    network: tcp
  - name: "Edge: \"quoted\" - true tro-colon"
    type: trojan
    server: edge.example.com
    port: 19
    password: "true"
    network: tcp
  - name: "Edge: \"quoted\" - true dup"
    type: vmess
    server: edge.example.com
    port: 21
    uuid: b6
    alterId: 0
    cipher: auto
    network: tcp
  - name: "Edge: \"quoted\" - true dup #2"
    type: vmess
    server: edge.example.com
    port: 21
    uuid: b7
    alterId: 0
    cipher: auto
    network: tcp
  - name: "Edge: \"quoted\" - true grpc-empty"
    type: vless
    server: edge.example.com
    port: 22
    uuid: b8
    network: grpc
    grpc-opts:
      grpc-service-name: ""
  - name: "Edge: \"quoted\" - true xh-nomode"
    type: vless
    server: edge.example.com
    port: 23
    uuid: b9
    network: xhttp
    tls: true
    servername: r.example.com
    client-fingerprint: chrome
    reality-opts:
      public-key: P
    xhttp-opts:
      path: /x
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - "Edge: \"quoted\" - true kcp"
      - "Edge: \"quoted\" - true split"
      - "Edge: \"quoted\" - true ws-hdr"
      - "Edge: \"quoted\" - true ws-both"
      - "Edge: \"quoted\" - true hu"
      - "Edge: \"quoted\" - true vmg"
      - "Edge: \"quoted\" - true rx-nofp"
      - "Edge: \"quoted\" - true tls-vision"
      - "Edge: \"quoted\" - true plain-vision"
      - "Edge: \"quoted\" - true ss-tcp"
      - "Edge: \"quoted\" - true ss-udp-only"
      - "Edge: \"quoted\" - true hy-nosni"
      - "Edge: \"quoted\" - true sec-weird"
      - "Edge: \"quoted\" - true tro-123"
      - "Edge: \"quoted\" - true tro-colon"
      - "Edge: \"quoted\" - true dup"
      - "Edge: \"quoted\" - true dup #2"
      - "Edge: \"quoted\" - true grpc-empty"
      - "Edge: \"quoted\" - true xh-nomode"
rule-providers:
  geosite-category-ads-all:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/category-ads-all.list"
    interval: 86400
  geosite-private:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/private.list"
    interval: 86400
  geoip-private:
    type: http
    behavior: ipcidr
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/private.list"
    interval: 86400
  geosite-cn:
    type: http
    behavior: domain
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geosite/cn.list"
    interval: 86400
  geoip-cn:
    type: http
    behavior: ipcidr
    format: text
    url: "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@meta/geo/geoip/cn.list"
    interval: 86400
rules:
  - RULE-SET,geosite-category-ads-all,REJECT
  - RULE-SET,geosite-private,DIRECT
  - RULE-SET,geoip-private,DIRECT,no-resolve
  - RULE-SET,geosite-cn,DIRECT
  - RULE-SET,geoip-cn,DIRECT,no-resolve
  - MATCH,PROXY




















































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































