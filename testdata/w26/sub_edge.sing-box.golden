      "uuid": "a7",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "PK",
          "short_id": ""
        }
      }
    },
    {
      "tag": "tls-vision",
      "type": "vless",
      "server": "edge.example.com",
      "server_port": 9,
      "uuid": "a8",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "v.example.com"
      }
    },
    {
      "tag": "plain-vision",
