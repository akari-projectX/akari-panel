      "tls": {
        "enabled": true
      },
      "transport": {
        "type": "httpupgrade",
        "path": "/"
      }
    },
    {
      "tag": "vmg",
      "type": "vmess",
      "server": "edge.example.com",
      "server_port": 7,
      "uuid": "a6",
      "tls": {
        "enabled": true,
        "server_name": "g.example.com"
      },
      "transport": {
        "type": "grpc",
        "service_name": "a b/c"
      }
    },
    {
