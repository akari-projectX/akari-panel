[Proxy Group]
🚀 默认代理 = select, ♻️ 自动选择, 🇭🇰 香港, 🇯🇵 日本, 🇺🇸 美国, 🇸🇬 新加坡, 🇹🇼 台湾, t5, t6, t7, t8, t12, t13, t14, ss-tcp, DIRECT
♻️ 自动选择 = url-test, t5, t6, t7, t8, t12, t13, t14, ss-tcp, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50
🎬 Netflix = select, 🚀 默认代理, 🇭🇰 香港, 🇯🇵 日本, 🇺🇸 美国, 🇸🇬 新加坡, 🇹🇼 台湾, ♻️ 自动选择, t5, t6, t7, t8, t12, t13, t14, ss-tcp, DIRECT
🔍 Google = select, 🚀 默认代理, 🇭🇰 香港, 🇯🇵 日本, 🇺🇸 美国, 🇸🇬 新加坡, 🇹🇼 台湾, ♻️ 自动选择, t5, t6, t7, t8, t12, t13, t14, ss-tcp, DIRECT
📺 YouTube = select, 🚀 默认代理, 🇭🇰 香港, 🇯🇵 日本, 🇺🇸 美国, 🇸🇬 新加坡, 🇹🇼 台湾, ♻️ 自动选择, t5, t6, t7, t8, t12, t13, t14, ss-tcp, DIRECT
✈️ Telegram = select, 🚀 默认代理, 🇭🇰 香港, 🇯🇵 日本, 🇺🇸 美国, 🇸🇬 新加坡, 🇹🇼 台湾, ♻️ 自动选择, t5, t6, t7, t8, t12, t13, t14, ss-tcp, DIRECT
🤖 AI 服务 = select, 🚀 默认代理, 🇭🇰 香港, 🇯🇵 日本, 🇺🇸 美国, 🇸🇬 新加坡, 🇹🇼 台湾, ♻️ 自动选择, t5, t6, t7, t8, t12, t13, t14, ss-tcp, DIRECT
🇭🇰 香港 = url-test, include-all-proxies=true, policy-regex-filter=(?i)港|hk|hong, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50
🇯🇵 日本 = url-test, include-all-proxies=true, policy-regex-filter=(?i)日本|jp|japan, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50
🇺🇸 美国 = url-test, include-all-proxies=true, policy-regex-filter=(?i)美国|美國|us|united, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50
🇸🇬 新加坡 = url-test, include-all-proxies=true, policy-regex-filter=(?i)新加坡|狮城|sg|singapore, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50
🇹🇼 台湾 = url-test, include-all-proxies=true, policy-regex-filter=(?i)台湾|台灣|tw|taiwan, url=http://www.gstatic.com/generate_204, interval=300, tolerance=50

