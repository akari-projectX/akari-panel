    type: select
    proxies:
      - 🚀 默认代理
      - 🇭🇰 香港
      - 🇯🇵 日本
      - 🇺🇸 美国
      - 🇸🇬 新加坡
      - 🇹🇼 台湾
      - ♻️ 自动选择
      - kcp
