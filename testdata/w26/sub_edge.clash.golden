  - name: 📺 YouTube
    type: select
    proxies:
      - 🚀 默认代理
      - 🇭🇰 香港
      - 🇯🇵 日本
      - 🇺🇸 美国
      - 🇸🇬 新加坡
      - 🇹🇼 台湾
      - ♻️ 自动选择
      - kcp
      - split
      - ws-hdr
      - ws-both
      - hu
      - vmg
      - rx-nofp
      - tls-vision
      - plain-vision
      - ss-tcp
      - ss-udp-only
      - hy-nosni
      - sec-weird
      - tro-123
      - tro-colon
      - dup
      - "dup #2"
      - grpc-empty
      - xh-nomode
      - DIRECT
  - name: ✈️ Telegram
    type: select
    proxies:
      - 🚀 默认代理
      - 🇭🇰 香港
      - 🇯🇵 日本
      - 🇺🇸 美国
      - 🇸🇬 新加坡
      - 🇹🇼 台湾
      - ♻️ 自动选择
      - kcp
      - split
      - ws-hdr
      - ws-both
      - hu
      - vmg
      - rx-nofp
      - tls-vision
      - plain-vision
      - ss-tcp
