content-type: text/yaml; charset=utf-8
mixed-port: 7890
mode: rule
log-level: warning
ipv6: false
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - +.lan
    - +.local
    - rule-set:geosite-private
    - +.msftconnecttest.com
    - +.msftncsi.com
    - time.*.com
    - ntp.*.com
  default-nameserver:
    - "223.5.5.5"
  proxy-server-nameserver:
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query
  nameserver-policy:
    "rule-set:geosite-private,geosite-cn":
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  respect-rules: true
proxies:
  - name: kcp
    type: vless
    server: edge.example.com
    port: 65535
    uuid: a1
    network: kcp
  - name: split
    type: vless
    server: edge.example.com
    port: 2
    uuid: a2
    network: xhttp
    xhttp-opts:
      path: /s p#?
      host: h.example.com
  - name: ws-hdr
    type: vless
    server: edge.example.com
    port: 3
    uuid: a3
    network: ws
    ws-opts:
      path: /
      headers:
        Host: hdr.example.com
  - name: ws-both
    type: vmess
    server: edge.example.com
    port: 4
    uuid: a4
    alterId: 0
    cipher: auto
    network: ws
    ws-opts:
      path: /w?ed=2048
      headers:
        Host: host.example.com
  - name: hu
    type: trojan
    server: edge.example.com
    port: 5
    password: p@ss word
    network: ws
    tls: true
    ws-opts:
      path: /
      v2ray-http-upgrade: true
  - name: vmg
    type: vmess
    server: edge.example.com
    port: 7
    uuid: a6
    alterId: 0
    cipher: auto
    network: grpc
    tls: true
    servername: g.example.com
    grpc-opts:
      grpc-service-name: a b/c
  - name: rx-nofp
    type: vless
    server: edge.example.com
    port: 8
    uuid: a7
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    client-fingerprint: chrome
    reality-opts:
      public-key: PK
  - name: tls-vision
    type: vless
    server: edge.example.com
    port: 9
    uuid: a8
    flow: xtls-rprx-vision
    network: tcp
    tls: true
    servername: v.example.com
  - name: plain-vision
    type: vless
    server: edge.example.com
    port: 10
    uuid: a9
    network: tcp
  - name: ss-tcp
    type: ss
    server: edge.example.com
    port: 14
    cipher: 2022-blake3-aes-128-gcm
    password: AAAAAAAAAAAAAAAAAAAAAA==:AQEBAQEBAQEBAQEBAQEBAQ==
    udp: false
  - name: ss-udp-only
    type: ss
    server: edge.example.com
    port: 15
    cipher: 2022-blake3-aes-256-gcm
    password: pw:u
    udp: true
  - name: hy-nosni
    type: hysteria2
    server: edge.example.com
    port: 16
    password: a:b c
    alpn:
      - h3
  - name: sec-weird
    type: vless
    server: edge.example.com
    port: 17
    uuid: b4
    network: tcp
  - name: tro-123
    type: trojan
    server: edge.example.com
    port: 18
    password: "123"
    network: tcp
  - name: tro-colon
    type: trojan
    server: edge.example.com
    port: 19
    password: "true"
    network: tcp
  - name: dup
    type: vmess
    server: edge.example.com
    port: 21
    uuid: b6
    alterId: 0
    cipher: auto
    network: tcp
  - name: "dup #2"
    type: vmess
    server: edge.example.com
    port: 21
    uuid: b7
    alterId: 0
    cipher: auto
    network: tcp
  - name: grpc-empty
    type: vless
    server: edge.example.com
    port: 22
    uuid: b8
    network: grpc
    grpc-opts:
      grpc-service-name: ""
  - name: xh-nomode
    type: vless
    server: edge.example.com
    port: 23
    uuid: b9
    network: xhttp
    tls: true
    servername: r.example.com
    client-fingerprint: chrome
    reality-opts:
      public-key: P
    xhttp-opts:
      path: /x
proxy-groups:
  - name: 🚀 默认代理
    type: select
    proxies:
      - ♻️ 自动选择
      - 🇭🇰 香港
      - 🇯🇵 日本
      - 🇺🇸 美国
      - 🇸🇬 新加坡
      - 🇹🇼 台湾
      - kcp
      - split
      - ws-hdr
      - ws-both
      - hu
      - vmg
      - rx-nofp
      - tls-vision
      - plain-vision
      - ss-tcp
      - ss-udp-only
      - hy-nosni
      - sec-weird
      - tro-123
      - tro-colon
      - dup
      - "dup #2"
      - grpc-empty
      - xh-nomode
      - DIRECT
  - name: ♻️ 自动选择
    type: url-test
    url: https://www.gstatic.com/generate_204
    interval: 300
    proxies:
      - kcp
      - split
      - ws-hdr
      - ws-both
      - hu
      - vmg
      - rx-nofp
      - tls-vision
      - plain-vision
      - ss-tcp
      - ss-udp-only
      - hy-nosni
      - sec-weird
      - tro-123
      - tro-colon
      - dup
      - "dup #2"
      - grpc-empty
      - xh-nomode
  - name: 🎬 Netflix
