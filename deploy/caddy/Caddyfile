# Caddy in front of the panel (compose service or bare metal).
#
# ONLY the secret prefix is forwarded, on every domain. Everything else
# (including "/") gets an empty 404 from Caddy itself: the panel is not
# reachable, and not identifiable, without the prefix.
#
# Domains (R22): AKARI_DOMAIN is served as before. Every other domain set in
# the admin "系统设置" (main domain, subscription domain) gets its
# certificate on demand: at the first TLS handshake for a new name Caddy asks
# the panel's internal `ask` endpoint (panel.toml [tls_ask]) and obtains a
# certificate only if the panel answers 200 for it. No Caddyfile edits when
# the domains change. The node communication domain is NOT served here:
# agents dial the panel's gRPC port (8443) directly.
#
# Bare metal: export AKARI_DOMAIN / AKARI_PREFIX in Caddy's environment and
#   AKARI_UPSTREAM=127.0.0.1:8080  AKARI_ASK=http://127.0.0.1:8082/ask
# panel.toml then needs trusted_proxies = ["127.0.0.1/32"] and
# [tls_ask] bind = "127.0.0.1:8082".
{
	# Extra global options from the environment (compose: .env
	# AKARI_CADDY_OPTIONS), empty by default. `local_certs` = every
	# certificate from Caddy's internal CA: a test or LAN name without public
	# DNS (myapp.test), where Let's Encrypt cannot issue (DEPLOY.md §A).
	{$AKARI_CADDY_OPTIONS}
	# An IP-only site address makes clients send no SNI, and the handshake
	# fails; default_sni makes Caddy pick the certificate anyway. Harmless
	# with a domain.
	default_sni {$AKARI_DOMAIN}
	on_demand_tls {
		# 200 only for the configured domains (rate limited by the panel).
		ask {$AKARI_ASK:http://panel:8082/ask}
	}
	# Optional, with Cloudflare in front: let Caddy keep Cloudflare's
	# X-Forwarded-For (the panel also works without it: with "trust
	# Cloudflare" it reads CF-Connecting-IP behind an edge hop). List the
	# ranges from https://www.cloudflare.com/ips (docs/DEPLOY.md "Cloudflare"):
	#   servers {
	#       trusted_proxies static 173.245.48.0/20 103.21.244.0/22 ...
	#   }
}

(akari) {
	encode zstd gzip
	# -Via: Caddy adds "Via: 1.1 Caddy" to proxied responses, so the panel's own
	# rejections would differ from the 404 below (a prefix oracle). Block form:
	# both deletions apply to every response, proxied or not.
	header {
		-Server
		-Via
	}

	# Access logging is OFF by default in Caddy. If you enable it, keep the
	# URI out: it contains the secret prefix and subscription tokens.
	#   log {
	#       format filter {
	#           request>uri delete
	#           request>headers delete
	#       }
	#   }

	handle /{$AKARI_PREFIX}/* {
		# Caddy appends the client to X-Forwarded-For (and, because upstream
		# proxies are not trusted, discards a client-supplied one). The Host
		# header is passed through: the panel refuses names it does not know.
		reverse_proxy {$AKARI_UPSTREAM:panel:8080} {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Everything else: empty 404.
	handle {
		respond 404
	}
}

{$AKARI_DOMAIN} {
	import akari
}

# Plain HTTP for AKARI_DOMAIN: the redirect to https is ours, not Caddy's
# automatic one (that one answers with "Server: Caddy", identifying the
# proxy). ACME HTTP-01 challenges are answered before any site route
# (Caddy 2.11), so certificates keep being issued and renewed.
http://{$AKARI_DOMAIN} {
	header {
		-Server
		-Via
	}
	redir https://{host}{uri} 308
}

# Any other name: certificate on demand, only for domains the panel
# confirms through the ask endpoint (unknown names fail the TLS handshake).
# A request without SNI (https://<ip>) gets AKARI_DOMAIN's certificate
# (default_sni) and lands here: the same empty 404, and the panel refuses
# unknown Host names behind the prefix (host gate) with that same 404.
https:// {
	tls {
		on_demand
	}
	import akari
}

# Plain HTTP: AKARI_DOMAIN is redirected to https (block above); every
# other host (the bare IP, unknown names, the 系统设置 domains, whose links
# are always https) gets the same empty 404 instead of a redirect or
# Caddy's default empty 200. ACME HTTP challenges are still answered.
http:// {
	header {
		-Server
		-Via
	}
	respond 404
}
