# Mounted by docker-compose.yml as /etc/akari/panel.toml (no secrets here:
# database_url / valkey_url come from env/panel.env). Only what the process
# needs to start (R39); everything else is set in 系统设置 (database).
data_dir = "/data"

[web]
bind = "0.0.0.0:8080"              # private `frontend` network only, never published
cookie_secure = true
trusted_proxies = ["172.28.0.0/24"] # the compose `frontend` subnet (Caddy lives there)

[grpc]
# Published for agents (mTLS); they dial 系统设置 → 节点通信域名.
bind = "0.0.0.0:8443"

[metrics]
# Scrape from another container on the backend network, never published.
bind = "0.0.0.0:9100"
allow_non_loopback = true

[tls_ask]
# Caddy on-demand TLS: certificates for the main/subscription domains set in
# 系统设置 (deploy/caddy/Caddyfile asks here). Private frontend network only,
# never published.
bind = "0.0.0.0:8082"
allow_non_loopback = true
