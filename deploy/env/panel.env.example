# Copy to env/panel.env (chmod 600). Overrides panel.toml.
DATABASE_URL=postgres://akari:CHANGE-ME-db@postgres:5432/akari
VALKEY_URL=redis://:CHANGE-ME-valkey@valkey:6379
# AKARI_ADMIN_PASSWORD is read by `akari admin add` only; pass it with
# `docker compose exec -e AKARI_ADMIN_PASSWORD=... panel /akari admin add root`
# rather than storing it here.
