# akari node agent (see docs/DEPLOY.md, "Add a node").
#
#   install -m 0755 agent /usr/local/bin/akari-agent
#   install -d -m 0700 /etc/akari-agent
#   install -m 0600 <node>-bootstrap.toml /etc/akari-agent/bootstrap.toml
#   install -m 0644 akari-agent.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now akari-agent
#
# The bootstrap file holds a one-time enrollment token (v1 files: the
# node's private key): it stays root-only (0600) and is handed to the
# service as a credential (needs systemd >= 250), so the service runs as a
# throw-away user and cannot read /etc. The agent generates its own key and
# keeps key + certificates in its StateDirectory (/var/lib/private/
# akari-agent, 0700, files 0600; $STATE_DIRECTORY): back it up or the node
# must re-enroll with a new token (`akari node enroll-token`).
#
# Self-update (M6, docs/DEPLOY.md "Agent updates"): the binary above stays
# the launcher. Verified updates are staged in the StateDirectory (update/)
# and the agent replaces its own process image (same PID). A staged binary
# that crashes is restarted by Restart=always through the launcher, which
# counts the boots and falls back to the previous binary. Nothing here needs
# to change; the StateDirectory must not be mounted noexec.
[Unit]
Description=Akari node agent (xray-core)
Documentation=https://github.com/akari-projectX/akari-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=bootstrap.toml:/etc/akari-agent/bootstrap.toml
StateDirectory=akari-agent
StateDirectoryMode=0700
ExecStart=/usr/local/bin/akari-agent -config %d/bootstrap.toml
Restart=always
RestartSec=3
TimeoutStopSec=20
LimitNOFILE=1048576

# --- hardening ------------------------------------------------------------
# Inbounds below port 1024 (443!) need CAP_NET_BIND_SERVICE; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
