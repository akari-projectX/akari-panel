# /etc/akari/panel.toml  (bare metal: chmod 0640, owner root:akari; it holds
# the database password). Validate before (re)starting:
#   sudo -u akari akari -c /etc/akari/panel.toml config check
#
# Only what the process needs to start (R39). Everything else — domains,
# Cloudflare, latency tests, ACME, retention, extra release
# keys — is set in the admin console (系统设置) and stored in the database.
# Keys of older releases are obsolete: imported into 系统设置 once on the
# first start, then ignored (docs/DEPLOY.md "Upgrading: obsolete keys").

data_dir = "/var/lib/akari"
database_url = "postgres://akari:CHANGE-ME@127.0.0.1:5432/akari"
valkey_url = "redis://:CHANGE-ME@127.0.0.1:6379"

[web]
# Behind a reverse proxy on the same host: loopback only.
bind = "127.0.0.1:8080"
cookie_secure = true
# The proxy's address AS THE PANEL SEES IT. X-Forwarded-For is honoured only
# from these peers (login rate limit, per-client addressing).
trusted_proxies = ["127.0.0.1/32"]

[grpc]
# Agents dial this directly with mTLS: public, NOT behind an HTTP proxy.
# The address they dial is 系统设置 → 节点通信 → 节点通信域名 (a domain
# without a port uses this port).
bind = "0.0.0.0:8443"

[metrics]
# Prometheus endpoint on its own listener (never the web port). Unset =
# disabled. Loopback unless allow_non_loopback = true (then firewall it).
bind = "127.0.0.1:9100"

[tls_ask]
# Caddy on-demand TLS ask endpoint (deploy/caddy/Caddyfile, AKARI_ASK):
# certificates for the domains set in 系统设置. Loopback only.
bind = "127.0.0.1:8082"
