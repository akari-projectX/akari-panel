# /etc/akari/panel.toml  (bare metal: chmod 0640, owner root:akari; it holds
# the database password). Validate before (re)starting:
#   sudo -u akari akari -c /etc/akari/panel.toml config check
#
# Replace panel.example.com / 203.0.113.10 with the host agents will dial.

data_dir = "/var/lib/akari"
database_url = "postgres://akari:CHANGE-ME@127.0.0.1:5432/akari"
valkey_url = "redis://:CHANGE-ME@127.0.0.1:6379"

[web]
# Behind a reverse proxy on the same host: loopback only.
bind = "127.0.0.1:8080"
cookie_secure = true
# The proxy's address AS THE PANEL SEES IT. X-Forwarded-For is honoured only
# from these peers (login rate limit, per-client addressing).
trusted_proxies = ["127.0.0.1/32"]
# Names/IPs the gRPC server certificate is valid for. Must include the host
# part of grpc.advertise AND grpc.server_name.
advertised_names = ["panel.example.com"]

[grpc]
# Agents dial this directly with mTLS: public, NOT behind an HTTP proxy.
bind = "0.0.0.0:8443"
advertise = "panel.example.com:8443"
server_name = "panel.example.com"
# Fail-closed lease: an agent that hears nothing for this long stops xray.
# 1 hour .. 30 days.
lease_seconds = 86400

[metrics]
# Prometheus endpoint on its own listener (never the web port). Unset =
# disabled. Loopback unless allow_non_loopback = true (then firewall it).
bind = "127.0.0.1:9100"

[install]
# One-line node installer (docs/DEPLOY.md §3). Origin nodes download from;
# default "" = the origin of the admin's browser.
# public_url = "https://panel.example.com"
# Install links (enrollment tokens) live 1 h by default.
# token_ttl_secs = 3600
