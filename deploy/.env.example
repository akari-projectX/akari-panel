# docker compose variables (copy to .env next to docker-compose.yml)
#
# The panel image, pinned by tag and digest: copy the line from the GitHub
# release notes (or its akari-panel-image.txt asset) after verifying it
# (docs/DEPLOY.md "Verify a release"). Upgrading = replacing this line.
AKARI_IMAGE=ghcr.io/akari-projectx/akari-panel:0.3.2@sha256:REPLACE-WITH-THE-RELEASE-DIGEST
AKARI_DOMAIN=panel.example.com
# Extra Caddy global options. `local_certs` for a name without public DNS
# (Caddy internal CA; docs/DEPLOY.md §A). Leave empty for a public domain.
AKARI_CADDY_OPTIONS=
# Several options: a double-quoted value with \n between them, e.g.
#   AKARI_CADDY_OPTIONS="local_certs\nemail you@example.com"
# Published host ports (defaults 80 / 443 / 8443; inside the containers
# Caddy keeps 80/443). HTTP-01/TLS-ALPN certificates need 80/443 reachable.
AKARI_HTTP_PORT=80
AKARI_HTTPS_PORT=443
AKARI_GRPC_PORT=8443
